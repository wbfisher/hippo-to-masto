{
  "name": "hippo-to-masto",
  "version": "1.0.0",
  "description": "Sync posts from Bluesky (internethippo) to Mastodon",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "tsc -w",
    "generate-token": "ts-node src/generate-token.ts"
  },
  "keywords": ["bluesky", "mastodon", "sync"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@atproto/api": "^0.12.29",
    "masto": "^6.8.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
